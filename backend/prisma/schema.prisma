generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PendingUser {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String
  role              String
  organization_name String?
  organization_type String?
  organization_id   String?
  otp_code          String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@map("pending_users")
}

model Organization {
  id               String                      @id @default(cuid())
  name             String
  type             String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  plan_id          String?
  plan_expiry      DateTime?
  payment_phone    String?
  blogs            Blog[]
  customAttributes CustomAttributeDefinition[]
  events           Event[]
  plan             Plan?                       @relation(fields: [plan_id], references: [id])
  users            User[]

  @@index([plan_id], map: "organizations_plan_id_fkey")
  @@map("organizations")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  phone                 String?
  role                  String                 @default("orgAdmin")
  organizationId        String?
  organization_name     String?
  organization_type     String?
  password              String
  profile_photo_path    String?
  email_verified_at     DateTime?
  google_id             String?
  sex                   String?
  join_date             DateTime?
  address               String?
  plan_id               String?
  plan_expiry           DateTime?
  fayda_id              String?
  is_fayda_verified     Boolean                @default(false)
  is_verified           Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  blogs                 Blog[]                 @relation("BlogAuthor")
  customAttributeValues MemberAttributeValue[]
  members               Member[]
  notifications         Notification[]
  otpTokens             OtpToken?
  payments              Payment[]
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                  Plan?                  @relation(fields: [plan_id], references: [id])
  events                Event[]                @relation("eventattendees")

  @@index([organizationId], map: "users_organizationId_fkey")
  @@index([plan_id], map: "users_plan_id_fkey")
  @@map("users")
}

model SystemConfig {
  id                  String   @id @default(cuid())
  platformName        String   @default("OMMS")
  supportEmail        String   @default("support@omms.com")
  maintenanceMode     Boolean  @default(false)
  telebirrPhone       String?
  cbeBirrPhone        String?
  paymentInstructions String?
  contactPhone        String?  @default("+251 911 234 567")
  contactAddress      String?  @default("Addis Ababa, Ethiopia")
  contactEmail        String?  @default("info@omms.com")
  contactHours        String?  @default("Mon - Fri: 8:00 AM - 5:00 PM")
  showLiveChat        Boolean  @default(false)
  liveChatUrl         String?  @default("")
  facebookUrl         String?
  telegramUrl         String?
  linkedinUrl         String?
  updatedAt           DateTime @updatedAt

  @@map("system_configs")
}

model CustomAttributeDefinition {
  id             String                 @id @default(cuid())
  name           String
  type           String
  required       Boolean                @default(false)
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         MemberAttributeValue[]

  @@index([organizationId], map: "custom_attribute_definitions_organizationId_fkey")
  @@map("custom_attribute_definitions")
}

model MemberAttributeValue {
  id          String                    @id @default(cuid())
  memberId    String
  attributeId String
  value       String
  attribute   CustomAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  member      User                      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, attributeId])
  @@index([attributeId], map: "member_attribute_values_attributeId_fkey")
  @@map("member_attribute_values")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  otp_code  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_tokens")
}

model Member {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  role        String?
  status      String?
  join_date   DateTime?
  last_active DateTime?
  photo       String?
  user_id     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "members_user_id_fkey")
  @@map("members")
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  price         Float
  billing_cycle String
  type          String
  max_members   Int
  duration_days Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
  payments      Payment[]
  users         User[]

  @@map("plans")
}

model Payment {
  id               String   @id @default(cuid())
  user_id          String
  plan_id          String?
  amount           Float
  payment_method   String
  status           String
  transaction_id   String?
  receipt_url      String?
  rejection_reason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payer_type       String?
  payer_id         String?
  payee_type       String?
  payee_id         String?
  reference_type   String?
  reference_id     String?
  organization_id  String?
  plan             Plan?    @relation(fields: [plan_id], references: [id])
  user             User     @relation(fields: [user_id], references: [id])

  @@index([plan_id], map: "payments_plan_id_fkey")
  @@index([user_id], map: "payments_user_id_fkey")
  @@map("payments")
}

model Blog {
  id               String        @id @default(cuid())
  title            String
  content          String
  image            String?
  status           String        @default("draft")
  category         String        @default("general")
  tags             String?
  readTime         Int?
  author_id        String
  organizationId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  price            Float?
  payment_required Boolean       @default(false)
  author           User          @relation("BlogAuthor", fields: [author_id], references: [id])
  organizations    Organization? @relation(fields: [organizationId], references: [id])

  @@index([author_id], map: "blogs_author_id_fkey")
  @@index([organizationId], map: "blogs_organizationId_fkey")
  @@map("blogs")
}

model Event {
  id               String        @id @default(cuid())
  title            String
  description      String
  date             DateTime
  end_date         DateTime?
  location         String?
  image            String?
  status           String        @default("draft")
  category         String        @default("general")
  capacity         Int?
  virtualLink      String?
  contactEmail     String?
  organizationId   String?
  price            Float?
  payment_required Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organizations    Organization? @relation(fields: [organizationId], references: [id])
  users            User[]        @relation("eventattendees")

  @@index([organizationId], map: "events_organizationId_fkey")
  @@map("events")
}
