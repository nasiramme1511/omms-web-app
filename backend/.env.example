DATABASE_URL="mysql://user:password@host:3306/omms"
PORT=5000
JWT_SECRET=your_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Resend (for OTP, password reset, and notification emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
FRONTEND_URL=http://localhost:5174

# Render Deployment - also set these in Render dashboard:
# VITE_GOOGLE_CLIENT_ID  (same as GOOGLE_CLIENT_ID - used by frontend build)

# Seeding Variables
SEED_SUPERADMIN_EMAIL="admin@omms.com"
SEED_SUPERADMIN_PASSWORD="password123"
SEED_DEMO_ORG_ADMIN_EMAIL="demo@omms.com"
SEED_DEMO_ORG_ADMIN_PASSWORD="password123"
